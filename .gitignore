# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Local secrets and saved profiles
.env
*.local.json
profiles/

# Personal data. This is a public repo and the database holds a real training
# log: injury history, symptoms, body mass, where and when someone runs. None
# of it belongs in version control.
taper.db
*.db
*.db-journal
*.db-wal
*.sqlite
*.sqlite3

# Strava bulk exports and anything unpacked from one
activities.csv
export_*/
*.gpx
*.fit
*.tcx

# Record exports. Same reasoning as the database: a record history carries real
# race names, dates and finishing places, which is a map of where someone was.
*-records-*.txt
*.records.txt
